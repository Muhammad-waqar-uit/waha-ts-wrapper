{
  "name": "waha-ts",
  "version": "0.1.0",
  "description": "TypeScript wrapper for the WAHA WhatsApp REST API — sessions, messages, chats, groups, channels, media, and more",
  "keywords": [
    "whatsapp",
    "waha",
    "bot",
    "api",
    "wrapper",
    "typescript",
    "chat",
    "messaging",
    "baileys",
    "whatsapp-web"
  ],
  "license": "MIT",
  "author": "Muhammad Waqar <muhammadwaqar.business@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-waqar-uit/waha-ts-wrapper.git"
  },
  "homepage": "https://github.com/Muhammad-waqar-uit/waha-ts-wrapper#readme",
  "bugs": {
    "url": "https://github.com/Muhammad-waqar-uit/waha-ts-wrapper/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
